<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.evolveum.midpoint</groupId>
	<artifactId>integration-catalog</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>integration-catalog</name>
	<description>Integration catalog</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Override Spring Boot's managed 1.21.x: Docker Engine 29+ needs Testcontainers 2.x
		     (the 1.x line speaks Docker API 1.32, below the engine's minimum of 1.44). -->
		<testcontainers.version>2.0.5</testcontainers.version>
		<!-- Overridden to npx.cmd by the npx-windows profile -->
		<npx.executable>npx</npx.executable>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-logging</artifactId>
		</dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <dependency>
            <groupId>org.gitlab4j</groupId>
            <artifactId>gitlab4j-api</artifactId>
            <version>6.3.0</version>
        </dependency>

        <dependency>
            <groupId>org.kohsuke</groupId>
            <artifactId>github-api</artifactId>
            <version>2.0-rc.7</version>
        </dependency>

        <!-- Parses the Markdown tutorial text so it can be converted to AsciiDoc for the download bundle -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.29.0</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Runs a real Keycloak in Docker for KeycloakRealmIT (opt-in via -Dit.keycloak=true).
             2.x is required: the 1.x line Spring Boot manages speaks Docker API 1.32,
             which Docker Engine 29+ rejects (minimum is 1.44). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Software Bill of Materials generation. Opt-in, so ordinary builds are unaffected:

		         mvn package -Psbom

		     produces two CycloneDX documents under target/:
		         backend-sbom.json   - Maven dependency tree (test scope excluded)
		         frontend-sbom.json  - npm dependency tree of angular-frontend (dev deps excluded)

		     Both are standard CycloneDX JSON and can be fed to Dependency-Track, Grype,
		     Trivy or any other scanner for vulnerability and license checks.

		     The frontend part requires Node.js on the PATH. It resolves from angular-frontend's
		     package-lock.json alone, so no prior "npm install" is needed. -->
		<profile>
			<id>sbom</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.cyclonedx</groupId>
						<artifactId>cyclonedx-maven-plugin</artifactId>
						<version>2.9.1</version>
						<executions>
							<!-- Spring Boot's parent manages this plugin and contributes an execution
							     of its own (id "default") that writes an SBOM into the jar at
							     META-INF/sbom/application.cdx.json. Unbinding it keeps the BOM being
							     built once, at the single documented location below. Bind it back by
							     removing this block if the jar embedded SBOM is wanted as well. -->
							<execution>
								<id>default</id>
								<phase>none</phase>
							</execution>
							<execution>
								<id>backend-sbom</id>
								<phase>package</phase>
								<goals>
									<goal>makeBom</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<projectType>application</projectType>
							<outputFormat>json</outputFormat>
							<outputName>backend-sbom</outputName>
							<outputDirectory>${project.build.directory}</outputDirectory>
							<includeBomSerialNumber>true</includeBomSerialNumber>
							<!-- Only what ships in the jar; build/test tooling is not part of the product. -->
							<includeTestScope>false</includeTestScope>
						</configuration>
					</plugin>

					<!-- The frontend is a separate npm project that Maven does not otherwise build,
					     so its SBOM is produced by the official CycloneDX npm tool. -->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>frontend-sbom</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${npx.executable}</executable>
									<workingDirectory>${project.basedir}/angular-frontend</workingDirectory>
									<arguments>
										<argument>--yes</argument>
										<argument>@cyclonedx/cyclonedx-npm</argument>
										<argument>--package-lock-only</argument>
										<argument>--omit</argument>
										<argument>dev</argument>
										<!-- "npm ls" exits non zero on unsatisfied optional peer
										     dependencies (nunjucks wants chokidar 3.x while the tree
										     resolves 4.x). That is harmless but would otherwise fail
										     the build, so the SBOM is still produced. -->
										<argument>--ignore-npm-errors</argument>
										<argument>--output-format</argument>
										<argument>JSON</argument>
										<argument>--output-file</argument>
										<argument>${project.build.directory}/frontend-sbom.json</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- npx is a .cmd shim on Windows and must be invoked under that name. -->
		<profile>
			<id>npx-windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<properties>
				<npx.executable>npx.cmd</npx.executable>
			</properties>
		</profile>
	</profiles>

</project>
